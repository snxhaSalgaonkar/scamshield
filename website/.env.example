# Copy to .env.local and replace the placeholders. Never commit .env.local.

# ---- Data source ----
# mock     → built-in demo data, no backend needed (default)
# supabase → the configured Supabase project
NEXT_PUBLIC_DATA_SOURCE=mock

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server only. Used by the demo simulator to insert reports. Never expose to the browser or the Android app.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ---- /api/analyze LLM (optional; similarity model works without it) ----
# anthropic | gemini | none (local similarity model works without a hosted LLM)
LLM_PROVIDER=none
LLM_API_KEY=
# e.g. claude-haiku-5-5 (anthropic) or gemini-2.5-flash (gemini)
LLM_MODEL=claude-haiku-5-5

# ---- Demo simulator (/dev/simulate) in supabase mode ----
SIMULATOR_ENABLED=true
