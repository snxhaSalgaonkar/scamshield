# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Never expose to the browser or the Android app.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- /api/analyze LLM (optional; similarity model works without it) ----
# anthropic | gemini | none
LLM_PROVIDER=anthropic
LLM_API_KEY=
# e.g. claude-haiku-5-5 (anthropic) or gemini-2.5-flash (gemini)
LLM_MODEL=claude-haiku-5-5
