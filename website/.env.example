# Which backend the dashboard reads from.
#   mock -> built-in demo data, no backend needed (default)
#   api  -> the FastAPI backend at VITE_API_URL
VITE_DATA_SOURCE=mock

# FastAPI backend base URL (only used when VITE_DATA_SOURCE=api).
VITE_API_URL=http://localhost:8000

# Optional: WebSocket base URL for the live feed. Defaults to VITE_API_URL with http(s) -> ws(s).
# VITE_WS_URL=ws://localhost:8000
